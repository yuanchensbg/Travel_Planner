BEGIN:VEVENT
UID:a08-tag@meridian-asien
DTSTAMP:20261104T211944Z
DTSTART;VALUE=DATE:20261223
SUMMARY:Tag 8: Seilbahn → Takayama
DESCRIPTION:Morgens schwebt ihr mit der doppelstöckigen Gondel auf über 2
 .000 Meter\, vor euch die verschneiten Gipfel der Nordalpen. Am Nachmittag
  bummelt ihr durch Takayamas Altstadt mit ihren Holzhäusern und Sake-Brau
 ereien.
TRANSP:TRANSPARENT
END:VEVENT
BEGIN:VEVENT
UID:a08-0@meridian-asien
DTSTAMP:20261104T211944Z
DTSTART:20261223T090000
DURATION:PT1H
SUMMARY:Shin-Hotaka-Seilbahn auf 2.156 m
LOCATION:Shinhotaka Ropeway
DESCRIPTION:Doppelstöckige Gondel\, oben Aussichtsterrasse über die versc
 hneiten Nordalpen.
END:VEVENT
BEGIN:VEVENT
UID:a08-1@meridian-asien
DTSTAMP:20261104T211944Z
DTSTART:20261223T113000
DURATION:PT1H
SUMMARY:Fahrt nach Takayama (ca. 1 h)
LOCATION:Takayama
DESCRIPTION:Über die Bergstraße 471/158 hinunter nach Takayama\, Auto am 
 Hotel parken.
END:VEVENT
BEGIN:VEVENT
UID:a08-2@meridian-asien
DTSTAMP:20261104T211944Z
DTSTART:20261223T130000
DURATION:PT1H
SUMMARY:Mittag: Hida-Rind-Sushi an einem Straßenstand
DESCRIPTION:
END:VEVENT
BEGIN:VEVENT
UID:a08-3@meridian-asien
DTSTAMP:20261104T211944Z
DTSTART:20261223T143000
DURATION:PT1H
SUMMARY:Altstadt Sanmachi: Sake-Brauereien\, Holzhäuser
LOCATION:Sanmachi Suji\, Takayama
DESCRIPTION:Gassen aus der Edo-Zeit\, Brauereien mit Zedernkugeln über der
  Tür — viele bieten Sake-Proben.
END:VEVENT
BEGIN:VEVENT
UID:a08-4@meridian-asien
DTSTAMP:20261104T211944Z
DTSTART:20261223T160000
DURATION:PT1H
SUMMARY:Takayama Jinya\, das alte Regierungshaus
LOCATION:Takayama Jinya
DESCRIPTION:
END:VEVENT
BEGIN:VEVENT
UID:a08-5@meridian-asien
